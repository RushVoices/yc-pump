# Everything here is optional: with none of it set, the deployed site launches
# real coins on Pump.fun mainnet using the public Solana RPC.

# mainnet-beta (default) or devnet
CLUSTER=mainnet-beta
# Your RPC (Helius, Triton, QuickNode…). Strongly recommended: the public RPC is rate-limited.
RPC_URL=
# Comma-separated reviewer wallets (they can approve, reject and fund).
ADMIN_WALLETS=
# Treasury wallet shown in the docs (reviewers fund from their connected wallet).
TREASURY=

# Storage for applications. Add "Upstash for Redis" from the Vercel Marketplace and
# these are filled in for you (KV_REST_API_URL / KV_REST_API_TOKEN also work).
# Without it, applications live in server memory and can disappear.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Image + metadata pinning. Without it, uploads go through pump.fun's own IPFS endpoint.
PINATA_JWT=
PINATA_GATEWAY=

# Force the self-contained demo (simulated launches) even when the API is present.
# VITE_DEMO=1
